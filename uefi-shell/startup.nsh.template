@echo -off
# eGPU bring-up for an M.2 PCIe slot - rendered by scripts\Install-UsbShell.ps1
# Root port {{RP_PCI}} (mm prefix {{RP}}), GPU expected on bus {{SECBUS}}.
# Logs to \EFI\shell\egpu-log.txt, then shows the speed menu. The user types gen1..gen4.

# --- make the script folder the working directory ------------------------------
for %u run (0 9)
  if exist fs%u:\EFI\shell\flow.nsh then
    fs%u:
    cd \EFI\shell
  endif
endfor

echo "===================== NEW RUN =====================" >>a egpu-log.txt
date >>a egpu-log.txt
time >>a egpu-log.txt
echo "[1] root port {{RP_PCI}} decoded" >>a egpu-log.txt
pci {{RP_PCI}} -i >>a egpu-log.txt
echo "[1] PCIe capability ID at 0x{{CAP}} (expect 0x10):" >>a egpu-log.txt
mm {{RP}}{{CAP}} -pci -w 1 -n >>a egpu-log.txt

echo " "
echo "=== eGPU helper - logging to \EFI\shell\egpu-log.txt ==="
echo "PCIe capability check (must show 0x10):"
mm {{RP}}{{CAP}} -pci -w 1 -n
echo " "
echo "Choose the PCIe link speed - type one of these and press Enter:"
echo "   gen1   2.5 GT/s  (most stable)"
echo "   gen2   5 GT/s"
echo "   gen3   8 GT/s    (marginal on long or cheap risers)"
echo "   gen4   16 GT/s   (only if BOTH root port and GPU support it)"
echo " "
